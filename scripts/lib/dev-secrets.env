# The keys the app requires, for local runs and the image tests only: scripts/dev.sh,
# scripts/screenshot.sh, image-smoke-test.sh, deploy-stack-test.sh, backup-restore-test.sh. A VAPID
# key pair, a Document encryption key and the settings of a Document bucket. Not secrets, and never
# for a real installation: production generates its own (deployment.md "Push keys (VAPID)",
# "Environment variables", "Document files").
VAPID_PUBLIC_KEY=BOpIBL_-gmK6UO5_nWwbtShTId4qzCcIjN7zQH2zqrdzn35vWekEuDeE-lbSdxbiWVc_QNJuYUSKvNisAEAkdgc
VAPID_PRIVATE_KEY=DrztBIjVCcvH5noEf40PrkK2ZDEYfqfNGSXCwQJFoWo
VAPID_SUBJECT=mailto:dev@example.com
DOCUMENTS_ENCRYPTION_KEY=EmvPyTBlqvGTMuFVp71ghlJ56/m3GWnaQfZ/J/kOGVY=
# A bucket nothing serves: the image tests start the production configuration but upload no file,
# and the app reaches the bucket only on an upload or a download. scripts/dev.sh sets
# DOCUMENTS_FOLDER, which wins over these.
DOCUMENTS_S3_ENDPOINT=http://127.0.0.1:9
DOCUMENTS_S3_BUCKET=dev-documents
DOCUMENTS_S3_ACCESS_KEY_ID=dev-only
DOCUMENTS_S3_SECRET_ACCESS_KEY=dev-only
