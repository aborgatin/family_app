# Copy to `.env` next to docker-compose.yml and fill in real values. Placeholders only:
# never commit the real `.env` (CODING_STANDARDS A2).

# Public domain of the app; Caddy gets its HTTPS certificate for it. `localhost` uses Caddy's
# local CA (for trying the stack locally).
DOMAIN=family.example.com
# Email for the Let's Encrypt account (expiry notices).
ACME_EMAIL=you@example.com

# Image tag on ghcr.io/aborgatin/family_app: `latest`, or a commit SHA to pin/roll back.
APP_IMAGE_TAG=latest

POSTGRES_DB=family
POSTGRES_USER=family
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Session lifetime (sliding), e.g. 180d.
SESSION_TIMEOUT=180d
# How long an Invite link stays valid, e.g. 7d.
INVITE_TTL=7d
# How long a password reset link stays valid, e.g. 1h. Create one on the server with
#   docker compose run --rm app reset-password <member's email>
PASSWORD_RESET_TTL=1h

# Login limits: failed logins allowed per email and per client IP within the sliding window
# before further logins get "too many attempts". Counted in memory; a restart resets them.
LOGIN_LIMIT_PER_EMAIL=10
LOGIN_LIMIT_PER_IP=20
LOGIN_LIMIT_WINDOW=15m

# Push messages (Notifications and Reminders): the VAPID key pair, required. Generate it once,
# before the first `up`, and keep it: a new pair makes every device subscribe again.
#   docker run --rm --pull always ghcr.io/aborgatin/family_app:latest generate-vapid-keys
# prints the two lines to paste here.
VAPID_PUBLIC_KEY=paste-from-generate-vapid-keys
VAPID_PRIVATE_KEY=paste-from-generate-vapid-keys
# A contact for the push services (Apple, Google, Mozilla), required: mailto:<your email>.
VAPID_SUBJECT=mailto:you@example.com
# When a todo item whose Due date has no time is due (its Reminder), HH:MM in TZ.
REMINDER_MORNING_TIME=09:00

# Documents on Medical cards: the key their files are encrypted with, required, 32 bytes in
# base64. Generate it once with `openssl rand -base64 32` and keep it in the password manager next
# to BACKUP_PASSPHRASE: without it the files can't be read, and the files are not backed up.
DOCUMENTS_ENCRYPTION_KEY=paste-from-openssl-rand-base64-32

# Nightly backup targets: rclone `remote:bucket` pairs, space-separated; the remotes are defined in
# rclone.conf next to this file (copy rclone.conf.example). Every dump goes to each of them.
BACKUP_REMOTES="b2:family-backups-xxxx r2:family-backups"
# Encrypts every dump before upload. Keep a copy in a password manager: without it no dump can be
# restored. Generate one with `openssl rand -base64 33`.
BACKUP_PASSPHRASE=change-me-to-a-long-random-passphrase
BACKUP_RETENTION_DAYS=90
# Local time (in TZ) of the nightly backup, HH:MM. Install the host cron entry with
#   (crontab -l 2>/dev/null; deploy/backup.sh --cron-entry) | crontab -
# The host itself must run in TZ, since cron uses the host's time zone.
BACKUP_TIME=03:30

# IANA time zone of the server and containers.
TZ=Europe/Berlin
