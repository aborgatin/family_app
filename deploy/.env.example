# Copy to `.env` next to docker-compose.yml and fill in real values. Placeholders only:
# never commit the real `.env` (CODING_STANDARDS A2).

# Public domain of the app; Caddy gets its HTTPS certificate for it. `localhost` uses Caddy's
# local CA (for trying the stack locally).
DOMAIN=family.example.com
# Email for the Let's Encrypt account (expiry notices).
ACME_EMAIL=you@example.com

# Image tag on ghcr.io/aborgatin/family_app: `latest`, or a commit SHA to pin/roll back.
APP_IMAGE_TAG=latest

POSTGRES_DB=family
POSTGRES_USER=family
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Session lifetime (sliding), e.g. 180d.
SESSION_TIMEOUT=180d
# How long an Invite link stays valid, e.g. 7d.
INVITE_TTL=7d
# How long a password reset link stays valid, e.g. 1h. Create one on the server with
#   docker compose run --rm app reset-password <member's email>
PASSWORD_RESET_TTL=1h

# Login limits: failed logins allowed per email and per client IP within the sliding window
# before further logins get "too many attempts". Counted in memory; a restart resets them.
LOGIN_LIMIT_PER_EMAIL=10
LOGIN_LIMIT_PER_IP=20
LOGIN_LIMIT_WINDOW=15m

# Nightly backup target on the Storage Box: user@host:path
BACKUP_TARGET=u000000-sub1@u000000.your-storagebox.de:backups
BACKUP_RETENTION_DAYS=90
# Dedicated SSH key for BACKUP_TARGET and the SSH port (Storage Box: 23). The target's host key
# must be in BACKUP_SSH_KNOWN_HOSTS (default ~/.ssh/known_hosts) before the first backup.
BACKUP_SSH_KEY=/root/.ssh/family_backup
BACKUP_SSH_PORT=23
# Local time (in TZ) of the nightly backup, HH:MM. Install the host cron entry with
#   (crontab -l 2>/dev/null; deploy/backup.sh --cron-entry) | crontab -
# The host itself must run in TZ, since cron uses the host's time zone.
BACKUP_TIME=03:30

# IANA time zone of the server and containers.
TZ=Europe/Berlin
